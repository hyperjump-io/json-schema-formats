{
  "name": "@hyperjump/json-schema-formats",
  "version": "1.1.0",
  "description": "A collection of validation functions for the JSON Schema `format` keyword.",
  "keywords": [
    "JSON Schema",
    "format",
    "rfc3339",
    "rfc9557",
    "date",
    "date-time",
    "duration",
    "email",
    "hostname",
    "idn-hostname",
    "idn-email",
    "ipv4",
    "ipv6",
    "iri",
    "iri-reference",
    "json-pointer",
    "regex",
    "relative-json-pointer",
    "time",
    "uri",
    "uri-reference",
    "uri-template",
    "uuid"
  ],
  "author": "Jason Desrosiers <jdesrosi@gmail.com>",
  "license": "MIT",
  "repository": "github:hyperjump-io/json-schema-formats",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hyperjump-io"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "!src/**/*.test.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "generate": "node scripts/generate-patterns.js",
    "version": "node scripts/version-docs.js && git add website"
  },
  "devDependencies": {
    "@hyperjump/abnf": "^1.0.0",
    "@stylistic/eslint-plugin": "*",
    "@types/node": "*",
    "@types/punycode": "*",
    "@vitest/coverage-v8": "*",
    "json-schema-test-suite": "github:json-schema-org/json-schema-test-suite",
    "oxlint": "*",
    "oxlint-tsgolint": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "dependencies": {
    "@hyperjump/uri": "^2.0.2",
    "idn-hostname": "^15.1.2"
  }
}
