{
    "$schema": "../../node_modules/json-schema-test-suite/validation/validation-test-schema.json",
    "description": "uint32 validation",
    "tests": [
        {
            "description": "validation of non-number uint32 values",
            "schema": {
                "format": "uint32"
            },
            "tests": [
                {
                    "description": "all number formats ignore strings",
                    "data": "1",
                    "valid": true
                },
                {
                    "description": "all number formats ignore objects",
                    "data": {},
                    "valid": true
                },
                {
                    "description": "all number formats ignore arrays",
                    "data": [],
                    "valid": true
                },
                {
                    "description": "all number formats ignore booleans",
                    "data": false,
                    "valid": true
                },
                {
                    "description": "all number formats ignore nulls",
                    "data": null,
                    "valid": true
                }
            ]
        },
        {
            "description": "validation of unsigned 32-bit integers",
            "tags": [
                "format-assertion"
            ],
            "schema": {
                "format": "uint32"
            },
            "tests": [
                {
                    "description": "the smallest value",
                    "data": 0,
                    "valid": true
                },
                {
                    "description": "the largest value",
                    "data": 4294967295,
                    "valid": true
                },
                {
                    "description": "zero",
                    "data": 0,
                    "valid": true
                },
                {
                    "description": "one less than the smallest value",
                    "data": -1,
                    "valid": false
                },
                {
                    "description": "one more than the largest value",
                    "data": 4294967296,
                    "valid": false
                },
                {
                    "description": "a whole number with a fraction of zero",
                    "data": 1.0,
                    "valid": true
                },
                {
                    "description": "a number with a fraction",
                    "data": 1.5,
                    "valid": false
                },
                {
                    "description": "a very large number",
                    "data": 1e+300,
                    "valid": false
                }
            ]
        }
    ]
}
